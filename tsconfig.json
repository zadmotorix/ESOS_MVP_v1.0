{
  "compilerOptions":{
    "target":"ES2022",
    "module":"commonjs",
    "moduleResolution":"node",
    "resolveJsonModule":true,
    "strict":true,
    "esModuleInterop":true,
    "skipLibCheck":true,
    "jsx":"react-jsx",
    "allowSyntheticDefaultImports":true,
    "lib":["ES2022","DOM"],
    "outDir":"backend-dist"
  },
  "include":["backend/**/*.ts","prisma/**/*.ts","src/**/*.ts","src/**/*.tsx"]
}
